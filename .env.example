# OpenRouter / LLM
OPENROUTER_API_KEY=
LLAMA_CLOUD_API_KEY=
IDMS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
IDMS_OPENROUTER_MODEL=google/gemini-2.5-flash
IDMS_OPENROUTER_MODEL_SIMPLE=openai/gpt-4o-mini
IDMS_OPENROUTER_MODEL_COMPLEX=google/gemini-2.5-pro
IDMS_OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large
IDMS_ENABLE_OPENROUTER_FALLBACK=true
IDMS_OPENROUTER_TIMEOUT_SECONDS=60

# PostgreSQL
IDMS_DB_NAME=idms_demo
IDMS_DB_HOST=localhost
IDMS_DB_USER=postgres
IDMS_DB_PASSWORD=
IDMS_DB_PORT=5432

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=idms_demo_documents
IDMS_QDRANT_HOST=localhost
IDMS_QDRANT_PORT=6333
IDMS_QDRANT_API_KEY=
IDMS_QDRANT_COLLECTION=idms_demo_documents
IDMS_QDRANT_EMBEDDING_MODEL=openai/text-embedding-3-large
IDMS_QDRANT_EMBEDDING_DIMENSION=3072
IDMS_ENABLE_QDRANT_INDEX=true

# Query/runtime flags
IDMS_ENABLE_SEMANTIC_LLM_FALLBACK=true
IDMS_ENABLE_CONTEXTUAL_LLM_RESOLUTION_FALLBACK=true
IDMS_ENABLE_LLM_INTENT_PARSER=true
IDMS_FLASH_CONFIDENCE_THRESHOLD=0.78

# Optional paths
IDMS_LOG_DIR=log
IDMS_MARKDOWN_CACHE_DIR=generated/markdown